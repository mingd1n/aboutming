---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { directions, getDirection } from '../../../data/directions';
import { languages, type Lang } from '../../../i18n/ui';
import { getLocalizedPath, useTranslations } from '../../../i18n/utils';

export function getStaticPaths() {
  const paths = [];
  for (const lang of Object.keys(languages) as Lang[]) {
    for (const d of directions) {
      paths.push({ params: { lang, direction: d.href } });
    }
  }
  return paths;
}

const lang = Astro.params.lang as Lang;
const directionId = Astro.params.direction as string;
const direction = getDirection(directionId);
const t = useTranslations(lang);

if (!direction) {
  return Astro.redirect(getLocalizedPath(lang, 'resume'));
}
---

<BaseLayout lang={lang} title={direction.title[lang]} description={direction.summary[lang]}>
  <a
    href={getLocalizedPath(lang, 'resume')}
    class="inline-flex items-center gap-2 text-sm text-[var(--color-fg-muted)] transition hover:text-[var(--color-accent)]"
  >
    ← {t('common.back')} · {t('resume.title')}
  </a>

  <header class="mt-6 max-w-2xl">
    <p class="text-sm font-medium text-[var(--color-accent)]">{t('nav.resume')}</p>
    <h1 class="mt-2 font-[family-name:var(--font-display)] text-3xl font-semibold tracking-tight sm:text-4xl">
      {direction.title[lang]}
    </h1>
    <p class="mt-3 text-[var(--color-fg-muted)] leading-7">{direction.summary[lang]}</p>
    <p class="mt-2 text-xs text-[var(--color-fg-muted)]">
      {t('resume.source')}: Axel/{direction.source}
    </p>
  </header>

  <section class="mt-10 grid gap-4 lg:grid-cols-3">
    <div class="rounded-2xl border border-[var(--color-border)] bg-[var(--color-card)] p-5 lg:col-span-2">
      <h2 class="text-sm font-semibold uppercase tracking-wide text-[var(--color-fg-muted)]">
        {lang === 'zh' ? '摘录' : 'Excerpts'}
      </h2>
      <ul class="mt-4 space-y-3">
        {
          direction.highlights[lang].map((item) => (
            <li class="flex gap-3 text-sm leading-6">
              <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-[var(--color-accent)]" />
              <span>{item}</span>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="space-y-4">
      <div class="rounded-2xl border border-[var(--color-border)] bg-[var(--color-card)] p-5">
        <h2 class="text-sm font-semibold uppercase tracking-wide text-[var(--color-fg-muted)]">
          {lang === 'zh' ? '技能 / 标签' : 'Skills / tags'}
        </h2>
        <div class="mt-4 flex flex-wrap gap-2">
          {
            direction.skills[lang].map((skill) => (
              <span class="rounded-full bg-[var(--color-accent-soft)] px-3 py-1 text-xs text-[var(--color-accent)]">
                {skill}
              </span>
            ))
          }
        </div>
      </div>
      <div class="rounded-2xl border border-[var(--color-border)] bg-[var(--color-card)] p-5">
        <h2 class="text-sm font-semibold uppercase tracking-wide text-[var(--color-fg-muted)]">
          {lang === 'zh' ? 'vault 节点' : 'Vault nodes'}
        </h2>
        <ul class="mt-3 space-y-2 text-sm text-[var(--color-fg-muted)]">
          {
            direction.links.map((link) => (
              <li>
                <span class="text-[var(--color-fg)]">{link[lang]}</span>
                <span class="ml-2 text-xs">({link.note})</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>
