---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { directions } from '../../data/directions';
import { languages, type Lang } from '../../i18n/ui';
import { getLocalizedPath, useTranslations } from '../../i18n/utils';

export function getStaticPaths() {
  return (Object.keys(languages) as Lang[]).map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
---

<BaseLayout lang={lang} title={t('nav.home')} description={t('home.intro')}>
  <section class="relative overflow-hidden rounded-3xl border border-[var(--color-border)] bg-[var(--color-card)] px-6 py-10 sm:px-10 sm:py-14">
    <div class="pointer-events-none absolute -right-16 -top-16 h-56 w-56 rounded-full bg-[var(--color-accent-soft)] blur-3xl"></div>
    <div class="pointer-events-none absolute -bottom-20 left-10 h-48 w-48 rounded-full bg-[var(--color-accent)]/10 blur-3xl"></div>

    <p class="text-sm font-medium tracking-wide text-[var(--color-accent)]">{t('home.also')}</p>
    <h1 class="mt-3 max-w-2xl font-[family-name:var(--font-display)] text-4xl font-semibold tracking-tight sm:text-5xl">
      {t('home.greeting')}
    </h1>
    <p class="mt-3 text-sm text-[var(--color-fg-muted)]">{t('site.tagline')}</p>
    <p class="mt-5 max-w-2xl text-base leading-7 text-[var(--color-fg-muted)] sm:text-lg sm:leading-8">
      {t('home.intro')}
    </p>

    <div class="mt-8 flex flex-wrap gap-3">
      <a
        href={getLocalizedPath(lang, 'resume')}
        class="inline-flex items-center rounded-full bg-[var(--color-accent)] px-5 py-2.5 text-sm font-medium text-[var(--color-bg)] transition hover:opacity-90"
      >
        {t('home.cta.resume')}
      </a>
      <a
        href={getLocalizedPath(lang, 'notes')}
        class="inline-flex items-center rounded-full border border-[var(--color-border)] bg-[var(--color-bg)] px-5 py-2.5 text-sm font-medium transition hover:border-[var(--color-accent)] hover:text-[var(--color-accent)]"
      >
        {t('home.cta.notes')}
      </a>
      <a
        href={getLocalizedPath(lang, 'contact')}
        class="inline-flex items-center rounded-full border border-transparent px-5 py-2.5 text-sm font-medium text-[var(--color-fg-muted)] transition hover:text-[var(--color-fg)]"
      >
        {t('home.cta.contact')}
      </a>
    </div>
  </section>

  <section class="mt-14">
    <div class="mb-6">
      <h2 class="font-[family-name:var(--font-display)] text-2xl font-semibold tracking-tight">{t('home.directions')}</h2>
      <p class="mt-2 max-w-xl text-sm text-[var(--color-fg-muted)]">{t('home.directions.desc')}</p>
    </div>

    <div class="grid gap-4 sm:grid-cols-2">
      {
        directions.map((d) => (
          <a
            href={getLocalizedPath(lang, `resume/${d.href}`)}
            class="group rounded-2xl border border-[var(--color-border)] bg-[var(--color-card)] p-5 transition hover:-translate-y-0.5 hover:border-[var(--color-accent)] hover:shadow-sm"
          >
            <div class="flex items-start justify-between gap-3">
              <h3 class="font-[family-name:var(--font-display)] text-lg font-semibold">{d.title[lang]}</h3>
              <span class="text-[var(--color-fg-muted)] transition group-hover:text-[var(--color-accent)]">→</span>
            </div>
            <p class="mt-2 text-sm leading-6 text-[var(--color-fg-muted)]">{d.summary[lang]}</p>
            <div class="mt-4 flex flex-wrap gap-2">
              {d.skills[lang].slice(0, 3).map((skill) => (
                <span class="rounded-full bg-[var(--color-bg)] px-2.5 py-1 text-xs text-[var(--color-fg-muted)]">
                  {skill}
                </span>
              ))}
            </div>
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>
