---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { noteCategories } from '../../../data/notes';
import { languages, type Lang } from '../../../i18n/ui';
import { useTranslations } from '../../../i18n/utils';

export function getStaticPaths() {
  return (Object.keys(languages) as Lang[]).map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
---

<BaseLayout lang={lang} title={t('notes.title')} description={t('notes.subtitle')}>
  <header class="max-w-2xl">
    <p class="text-sm font-medium text-[var(--color-accent)]">{t('nav.notes')}</p>
    <h1 class="mt-2 font-[family-name:var(--font-display)] text-3xl font-semibold tracking-tight sm:text-4xl">
      {t('notes.title')}
    </h1>
    <p class="mt-3 text-[var(--color-fg-muted)] leading-7">{t('notes.subtitle')}</p>
  </header>

  <section class="mt-10 grid gap-4">
    {
      noteCategories.map((category) => (
        <article class="rounded-2xl border border-[var(--color-border)] bg-[var(--color-card)] p-5 sm:p-6">
          <div class="flex flex-wrap items-start justify-between gap-3">
            <div>
              <h2 class="font-[family-name:var(--font-display)] text-xl font-semibold">{category.title[lang]}</h2>
              <p class="mt-2 max-w-2xl text-sm leading-6 text-[var(--color-fg-muted)]">{category.description[lang]}</p>
              <p class="mt-1 text-xs text-[var(--color-fg-muted)]">Axel/{category.source}</p>
            </div>
            <span class="rounded-full bg-[var(--color-bg)] px-3 py-1 text-xs text-[var(--color-fg-muted)]">
              {category.topics[lang].length} {lang === 'zh' ? '主题' : 'topics'}
            </span>
          </div>
          <div class="mt-4 flex flex-wrap gap-2">
            {category.topics[lang].map((topic) => (
              <span class="rounded-full border border-[var(--color-border)] px-3 py-1 text-xs text-[var(--color-fg-muted)]">
                {topic}
              </span>
            ))}
          </div>
          <p class="mt-5 text-xs text-[var(--color-fg-muted)]">{t('notes.empty')}</p>
        </article>
      ))
    }
  </section>
</BaseLayout>
