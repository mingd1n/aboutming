---
import ThemeToggle from './ThemeToggle';
import { languages, type Lang } from '../i18n/ui';
import { getLocalizedPath, switchLangPath, useTranslations } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const path = Astro.url.pathname;

const links = [
  { href: getLocalizedPath(lang), label: t('nav.home'), match: `/${lang}` },
  { href: getLocalizedPath(lang, 'resume'), label: t('nav.resume'), match: `/${lang}/resume` },
  { href: getLocalizedPath(lang, 'notes'), label: t('nav.notes'), match: `/${lang}/notes` },
  { href: getLocalizedPath(lang, 'contact'), label: t('nav.contact'), match: `/${lang}/contact` },
];

function isActive(match: string) {
  if (match === `/${lang}`) {
    return path === `/${lang}` || path === `/${lang}/`;
  }
  return path === match || path.startsWith(`${match}/`);
}
---

<header class="sticky top-0 z-40 border-b border-[var(--color-border)]/80 bg-[var(--color-bg)]/85 backdrop-blur-md">
  <div class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-5 py-3.5 sm:px-6">
    <a href={getLocalizedPath(lang)} class="group flex items-center gap-2.5">
      <span class="flex h-8 w-8 items-center justify-center rounded-xl bg-[var(--color-accent)] text-sm font-semibold text-[var(--color-bg)]">
        M
      </span>
      <span class="font-[family-name:var(--font-display)] text-sm font-semibold tracking-tight sm:text-base">
        {t('site.title')}
      </span>
    </a>

    <nav class="hidden items-center gap-1 md:flex" aria-label="Primary">
      {
        links.map((link) => (
          <a
            href={link.href}
            class:list={[
              'rounded-full px-3.5 py-1.5 text-sm transition',
              isActive(link.match)
                ? 'bg-[var(--color-accent-soft)] text-[var(--color-accent)]'
                : 'text-[var(--color-fg-muted)] hover:text-[var(--color-fg)]',
            ]}
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      <div class="flex items-center rounded-full border border-[var(--color-border)] p-0.5 text-xs">
        {
          (Object.keys(languages) as Lang[]).map((code) => (
            <a
              href={switchLangPath(Astro.url, code)}
              class:list={[
                'rounded-full px-2.5 py-1 transition',
                code === lang
                  ? 'bg-[var(--color-fg)] text-[var(--color-bg)]'
                  : 'text-[var(--color-fg-muted)] hover:text-[var(--color-fg)]',
              ]}
              hreflang={code}
              lang={code}
            >
              {code.toUpperCase()}
            </a>
          ))
        }
      </div>
      <ThemeToggle client:load label={t('theme.toggle')} />
    </div>
  </div>

  <nav class="flex gap-1 overflow-x-auto border-t border-[var(--color-border)]/60 px-4 py-2 md:hidden" aria-label="Mobile">
    {
      links.map((link) => (
        <a
          href={link.href}
          class:list={[
            'whitespace-nowrap rounded-full px-3 py-1 text-xs transition',
            isActive(link.match)
              ? 'bg-[var(--color-accent-soft)] text-[var(--color-accent)]'
              : 'text-[var(--color-fg-muted)]',
          ]}
        >
          {link.label}
        </a>
      ))
    }
  </nav>
</header>
